# App — production URL used for Razorpay payment callbacks
# On Vercel, VERCEL_URL is used automatically if this is unset, but setting it explicitly is recommended.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB (Atlas recommended for Vercel)
# Example: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bni_event

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_long_random_secret
AUTH_SECRET=replace_with_long_random_secret

# Admin credentials
ADMIN_USERNAME=admin
# Prefer hashed password in production:
# npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Optional local/dev fallback only (do not use in production if hash is set):
ADMIN_PASSWORD=change-me-locally

# Razorpay (UPI Payment Links) — Live Mode keys required, UPI links do not work in Test Mode
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_key_secret
# Dashboard: Settings > Webhooks > Add webhook
# URL: <NEXT_PUBLIC_APP_URL>/api/webhooks/razorpay, event: payment_link.paid
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
